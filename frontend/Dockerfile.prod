FROM node:24-alpine AS build

ARG VITE_TOURNAMENT_BASE_URL
ENV VITE_TOURNAMENT_BASE_URL=$VITE_TOURNAMENT_BASE_URL

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.29-alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80

